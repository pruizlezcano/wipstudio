# App Configuration
WEB_URL=https://example.com

# WebSocket Configuration
# Optional: Override WebSocket URL (default: ws://localhost:3001 in dev, WEB_URL in prod)
# WS_URL=ws://localhost:3001

# Reverse Proxy (Caddy)
MINIO_HOST=rustfs
MINIO_PORT=9000
APP_HOST=wipstudio
APP_PORT=3000
WEBSOCKET_HOST=websocket
WEBSOCKET_PORT=3001

# Authentication
BETTER_AUTH_SECRET=some-very-secure-and-random-string
# Set to true to require email verification on sign up
REQUIRE_EMAIL_VERIFICATION=false
# Set to true to disable sign up entirely
DISABLE_SIGN_UP=false
# Set to true to disable email/password authentication (only OIDC will be available)
DISABLE_EMAIL_PASSWORD_AUTH=false

# OIDC Authentication
OPENID_ENABLED=false
OPENID_NAME=My OpenID Provider
OPENID_ID=my-openid
OPENID_CLIENT_ID=client-id
OPENID_CLIENT_SECRET=client-secret
OPENID_REDIRECT_URI=http://example.com/api/auth/oauth2/callback/my-openid
OPENID_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration
OPENID_SCOPES=openid profile email

# Database

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wipstudio
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/wipstudio

# S3
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY_ID=access-key
S3_SECRET_ACCESS_KEY=secret-key
S3_BUCKET=wipstudio-uploads
S3_REGION=us-east-1

# File Upload
# Leave unset or set to a very large value to disable chunking
UPLOAD_CHUNK_SIZE=5242880 # 5 MB

# Email Configuration
# Set to true to enable email sending
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="WIPStudio <your-email@gmail.com>"
